{
  "manifest_version": 3,
  "name": "BooTube LOCAL TEST - BOOTUBE-EXTENSION",
  "version": "1.31",
  "description": "Censor profanity on YouTube.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*.youtube.com/*",
    "*://*.disneyplus.com/*",
    "*://*.hulu.com/*",
    "*://*.plex.tv/*",
    "*://app.plex.tv/*",
    "*://*.plex.direct/*",
    "*://*.fandango.com/*",
    "*://*.vudu.com/*",
    "*://*.netflix.com/*",
    "*://*.amazon.com/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.ca/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "*://bootube.app/*",
    "*://*.bootube.app/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.spotify.com/*",
    "*://*.facebook.com/*",
    "*://*.fb.watch/*",
    "*://*.fbcdn.net/*",
    "*://*.messenger.com/*",
    "*://*.max.com/*",
    "*://*.hbomax.com/*",
    "*://*.paramountplus.com/*",
    "*://*.cbs.com/*",
    "*://*.cbsaavideo.com/*",
    "*://*.cbsinteractive.com/*",
    "*://*.theplatform.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hulu.com/*",
        "*://*.plex.tv/*",
        "*://app.plex.tv/*",
        "*://*.plex.direct/*",
        "*://*.fandango.com/*",
        "*://*.vudu.com/*",
        "*://*.netflix.com/*",
        "*://*.amazon.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.ca/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://bootube.app/*",
        "*://*.bootube.app/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.spotify.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.watch/*",
        "*://*.fbcdn.net/*",
        "*://*.messenger.com/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.paramountplus.com/*",
        "*://*.cbs.com/*",
        "*://*.cbsaavideo.com/*",
        "*://*.cbsinteractive.com/*",
        "*://*.theplatform.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hulu.com/*",
        "*://*.plex.tv/*",
        "*://app.plex.tv/*",
        "*://*.plex.direct/*",
        "*://*.fandango.com/*",
        "*://*.vudu.com/*",
        "*://*.netflix.com/*",
        "*://*.amazon.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.ca/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.spotify.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.watch/*",
        "*://*.fbcdn.net/*",
        "*://*.messenger.com/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.paramountplus.com/*",
        "*://*.cbs.com/*",
        "*://*.cbsaavideo.com/*",
        "*://*.cbsinteractive.com/*",
        "*://*.theplatform.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hulu.com/*",
        "*://*.plex.tv/*",
        "*://app.plex.tv/*",
        "*://*.plex.direct/*",
        "*://*.fandango.com/*",
        "*://*.vudu.com/*",
        "*://*.netflix.com/*",
        "*://*.amazon.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.ca/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.spotify.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.watch/*",
        "*://*.fbcdn.net/*",
        "*://*.messenger.com/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.paramountplus.com/*",
        "*://*.cbs.com/*",
        "*://*.cbsaavideo.com/*",
        "*://*.cbsinteractive.com/*",
        "*://*.theplatform.com/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "images/icon.png",
      "48": "images/icon.png",
      "128": "images/icon.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  }
}